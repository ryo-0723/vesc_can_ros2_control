<?xml version="1.0"?>
<!-- PID 値は模擬 VESC 用の例。実機の質量・負荷・機構に合わせて調整する。 -->
<robot name="vesc_prismatic_position_example">
  <link name="base_link"/>
  <link name="slider_link"/>
  <joint name="slider_joint" type="prismatic">
    <parent link="base_link"/><child link="slider_link"/><axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.3" effort="100.0" velocity="0.02"/>
  </joint>
  <ros2_control name="VescPositionSystem" type="system">
    <hardware>
      <plugin>vesc_can_ros2_control/VescSystem</plugin>
      <param name="can_tx_topic">can/tx</param>
      <param name="can_rx_topic">can/rx</param>
    </hardware>
    <joint name="slider_joint">
      <param name="logical_id">1</param>
      <param name="motor_id">11</param><param name="pole_pairs">7</param>
      <param name="gear_ratio">2.0</param><param name="direction">-1</param>
      <param name="linear_lead_m_per_rev">0.005</param>
      <param name="position_offset_m">0.1</param>
      <param name="control_mode">position</param>
      <param name="min_position">0.0</param><param name="max_position">0.3</param>
      <param name="max_velocity">0.02</param>
      <param name="velocity_slew_rate">0.05</param>
      <param name="max_current_a">2.0</param>
      <param name="position_pid_kp">1000.0</param>
      <param name="position_pid_ki">100.0</param>
      <param name="position_pid_kd">100.0</param>
      <param name="position_pid_integral_limit_a">0.5</param>
      <param name="position_pid_max_period_ms">100</param>
      <command_interface name="position"/>
      <state_interface name="position"/><state_interface name="velocity"/>
      <state_interface name="current"/>
    </joint>
  </ros2_control>
</robot>
