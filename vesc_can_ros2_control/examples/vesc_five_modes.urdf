<?xml version="1.0"?>
<!-- 5モードの設定例。controllers_five_modes.yaml と組み合わせる -->
<robot name="vesc_five_modes">
  <link name="base_link"/>
  <link name="drive_link"/>
  <link name="steer_link"/>
  <link name="current_link"/>
  <link name="hybrid_link"/>
  <link name="duty_link"/>
  <joint name="drive_joint" type="continuous">
    <parent link="base_link"/><child link="drive_link"/><axis xyz="0 1 0"/>
  </joint>
  <joint name="steer_joint" type="revolute">
    <parent link="base_link"/><child link="steer_link"/><axis xyz="0 0 1"/>
    <limit lower="-1.0" upper="1.0" effort="1.0" velocity="1.0"/>
  </joint>
  <joint name="current_joint" type="continuous">
    <parent link="base_link"/><child link="current_link"/><axis xyz="0 1 0"/>
  </joint>
  <joint name="hybrid_joint" type="continuous">
    <parent link="base_link"/><child link="hybrid_link"/><axis xyz="0 1 0"/>
  </joint>
  <joint name="duty_joint" type="continuous">
    <parent link="base_link"/><child link="duty_link"/><axis xyz="0 1 0"/>
  </joint>
  <ros2_control name="VescFiveModes" type="system">
    <hardware>
      <plugin>vesc_can_ros2_control/VescSystem</plugin>
      <param name="can_tx_topic">/bench/can/tx</param>
      <param name="can_rx_topic">/bench/can/rx</param>
      <param name="send_period_ms">10</param>
      <param name="fault_poll_period_ms">100</param>
      <param name="state_publish_period_ms">20</param>
      <param name="activation_timeout_ms">2000</param>
    </hardware>
    <joint name="drive_joint">
      <param name="logical_id">1</param>
      <param name="controller_id">11</param><param name="pole_pairs">7</param>
      <param name="control_mode">velocity</param>
      <param name="feedback_timeout_ms">300</param><param name="command_timeout_ms">300</param>
      <command_interface name="velocity"/>
      <state_interface name="position"/><state_interface name="velocity"/>
      <state_interface name="current"/>
    </joint>
    <joint name="steer_joint">
      <param name="logical_id">2</param>
      <param name="controller_id">21</param><param name="pole_pairs">7</param>
      <param name="control_mode">position</param>
      <param name="min_position">-1.0</param><param name="max_position">1.0</param>
      <param name="feedback_timeout_ms">300</param><param name="command_timeout_ms">300</param>
      <command_interface name="position"/>
      <state_interface name="position"/><state_interface name="velocity"/>
      <state_interface name="current"/>
    </joint>
    <joint name="current_joint">
      <param name="logical_id">3</param>
      <param name="controller_id">12</param><param name="pole_pairs">7</param>
      <param name="control_mode">current</param><param name="direction">-1</param>
      <param name="max_current_a">3.0</param>
      <param name="feedback_timeout_ms">300</param><param name="command_timeout_ms">300</param>
      <command_interface name="current"/>
      <state_interface name="position"/><state_interface name="velocity"/>
      <state_interface name="current"/>
    </joint>
    <joint name="hybrid_joint">
      <param name="logical_id">4</param>
      <param name="controller_id">31</param><param name="pole_pairs">7</param>
      <param name="control_mode">current_velocity</param>
      <param name="max_current_a">3.0</param><param name="startup_current_a">2.0</param>
      <param name="rpm_control_threshold_rpm">50.0</param>
      <param name="startup_timeout_ms">1000</param>
      <param name="feedback_timeout_ms">300</param><param name="command_timeout_ms">300</param>
      <command_interface name="velocity"/>
      <state_interface name="position"/><state_interface name="velocity"/>
      <state_interface name="current"/>
    </joint>
    <joint name="duty_joint">
      <param name="logical_id">5</param>
      <param name="controller_id">41</param><param name="pole_pairs">7</param>
      <param name="control_mode">duty_cycle</param><param name="direction">-1</param>
      <param name="max_duty">0.5</param>
      <param name="feedback_timeout_ms">300</param><param name="command_timeout_ms">300</param>
      <command_interface name="duty_cycle"/>
      <state_interface name="position"/><state_interface name="velocity"/>
      <state_interface name="duty_cycle"/>
    </joint>
  </ros2_control>
</robot>
