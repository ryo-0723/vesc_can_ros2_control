<?xml version="1.0"?>
<package format="3">
  <name>vesc_can_driver</name>
  <version>1.0.0</version>
  <description>Native VESC CAN frame encoding and decoding, shared driver, standalone ROS nodes, compact motor commands and fault notifications.</description>
  <maintainer email="tengbenliang742@gmail.com">ryo-0723</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/ryo-0723/vesc_can_ros2_control</url>
  <url type="bugtracker">https://github.com/ryo-0723/vesc_can_ros2_control/issues</url>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>can_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>vesc_can_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
