<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vesc_msgs</name>
  <version>0.1.0</version>
  <description>
    VESC state message definitions vendored from F1TENTH; IMU messages are excluded.
  </description>
  <maintainer email="tengbenliang742@gmail.com">ryo-0723</maintainer>
  <license>BSD-3-Clause</license>
  <url type="repository">https://github.com/ryo-0723/vesc_can_ros2_control</url>
  <url type="bugtracker">https://github.com/ryo-0723/vesc_can_ros2_control/issues</url>
  <author email="boulet@ll.mit.edu">Michael T. Boulet</author>
  <author email="josh.whitley@autoware.org">Joshua Whitley</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rosidl_default_generators</build_depend>
  <depend>std_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
